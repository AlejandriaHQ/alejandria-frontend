# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# System / editor files
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Logs
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
/coverage
*.lcov

# Ionic / Capacitor
/.ionic
/www
/platforms
/plugins

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
build/Release

# Node
/node_modules
jspm_packages/
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm
.eslintcache
.stylelintcache
/.angular
/.angular/cache
.sass-cache/
/.nx
/.nx/cache
/connect.lock
/libpeerconnection.log
testem.log
/typings

# dotenv
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
.vscode-test

# System files
.DS_Store
Thumbs.db

# Local tooling / helpers
.atl/
.opencode/
.agents/
skills/
*.skill.md
